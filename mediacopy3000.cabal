cabal-version: 3.4
name: mediacopy3000
version: 0.1.0
synopsis: Verified media offload and ASC MHL verification for videographers
license: GPL-3.0-only
license-file: LICENSE
author: Feriel Choutri de Tarlé
maintainer: feriel@choutri.eu
category: Distribution
build-type: Simple
data-files:
  assets/styles.css
  assets/themes/**/*.css
  assets/themes/**/*.json

extra-source-files:
  assets/tech.floreal.MediaCopy3000-symbolic.svg
  assets/tech.floreal.MediaCopy3000.gresource.xml
  assets/tech.floreal.MediaCopy3000.svg
  locales/*.ftl
  tests/fixtures/**/*.mhl
  tests/fixtures/**/*.xml
  tests/fixtures/**/*.xsd

tested-with: ghc ==9.14.1

common options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -fhide-source-paths
    -Wno-unused-do-bind
    -fshow-hole-constraints
    -Wno-unticked-promoted-constructors
    -fwrite-ide-info

  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    NoStarIsType
    OrPatterns
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    StrictData
    TypeFamilies
    ViewPatterns

  default-language: GHC2024

library domain
  import: options
  hs-source-dirs: src/domain
  -- cabal-gild: discover src/domain
  exposed-modules:
    MediaCopy.Domain.Destination
    MediaCopy.Domain.DirectoryHash
    MediaCopy.Domain.FileSystem
    MediaCopy.Domain.History
    MediaCopy.Domain.Job
    MediaCopy.Domain.JobFormat
    MediaCopy.Domain.Plan
    MediaCopy.Domain.Plugin
    MediaCopy.Domain.PluginCatalog
    MediaCopy.Domain.Preflight

  build-depends:
    ascmhl,
    base,
    bytestring,
    containers,
    effectful-core,
    filepath,
    plugin-protocol,
    text,
    text-display,
    time,
    vector,

library application
  import: options
  hs-source-dirs: src/application
  -- cabal-gild: discover src/application src/application-posix/
  exposed-modules:
    MediaCopy.Effects.Emit
    MediaCopy.Effects.FileSystem
    MediaCopy.Effects.FileSystem.Native
    MediaCopy.Effects.FileSystem.Types
    MediaCopy.Effects.Hasher
    MediaCopy.Effects.Plugins
    MediaCopy.Effects.Run
    MediaCopy.Engine
    MediaCopy.Engine.Generation
    MediaCopy.Engine.Plan
    MediaCopy.Engine.Violation
    MediaCopy.EventLog
    MediaCopy.Guard
    MediaCopy.Mhl.Store
    MediaCopy.Plugin.Catalog
    MediaCopy.Plugin.Discovery
    MediaCopy.Plugin.Fields
    MediaCopy.Plugin.Grants
    MediaCopy.Plugin.Process
    MediaCopy.Plugin.Process.Native
    MediaCopy.Plugin.Session
    MediaCopy.Plugin.Trace
    MediaCopy.Plugin.Wire
    MediaCopy.Signals

  other-modules: Paths_mediacopy3000
  autogen-modules: Paths_mediacopy3000
  build-depends:
    aeson,
    aeson-pretty,
    ascmhl,
    async,
    base,
    bytestring,
    containers,
    cryptohash-md5,
    cryptohash-sha1,
    cryptohash-sha512,
    directory,
    disk-free-space,
    effectful-core,
    file-io,
    filepath,
    mediacopy3000:domain,
    monad-time-effectful,
    os-string,
    plugin-protocol,
    primitive,
    process,
    stm,
    text,
    text-display,
    time,
    vector,
    xxhash-ffi ^>=0.3,

  if os(windows)
    hs-source-dirs: src/application-windows
    build-depends: Win32
  else
    hs-source-dirs: src/application-posix
    build-depends: unix

library interface
  import: options
  hs-source-dirs: src/interface
  -- cabal-gild: discover src/interface
  exposed-modules:
    MediaCopy.Interface.Command
    MediaCopy.Interface.Palette
    MediaCopy.Interface.Scene
    MediaCopy.Interface.Theme
    MediaCopy.Interface.Translation
    MediaCopy.Interface.Translation.Coverage
    MediaCopy.Interface.Translation.Embedded
    MediaCopy.Interface.Translation.English
    MediaCopy.Interface.Translation.French
    MediaCopy.Interface.Translation.Messages
    MediaCopy.Interface.Translation.Splice
    MediaCopy.Interface.View.JobDetail
    MediaCopy.Interface.View.JobRow
    MediaCopy.Interface.View.PlanSheet
    MediaCopy.Interface.View.Plugins
    MediaCopy.Interface.View.Row
    MediaCopy.Interface.Wording
    MediaCopy.Model
    MediaCopy.Report

  build-depends:
    aeson,
    ascmhl,
    base,
    containers,
    filepath,
    fluent,
    fluent-syntax,
    mediacopy3000:domain,
    optics-core,
    plugin-protocol,
    scientific,
    template-haskell,
    text,
    text-display,
    time,
    unicode-transforms,
    vector,

library demo
  import: options
  hs-source-dirs: src/demo
  -- cabal-gild: discover src/demo
  exposed-modules:
    MediaCopy.Demo
    MediaCopy.Demo.Fixtures

  build-depends:
    ascmhl,
    base,
    containers,
    filepath,
    mediacopy3000:domain,
    mediacopy3000:interface,
    plugin-protocol,
    text,
    text-display,
    time,
    vector,

library
  import: options
  hs-source-dirs: src/gtk
  -- cabal-gild: discover src/gtk
  exposed-modules:
    MediaCopy.Gtk.Actions
    MediaCopy.Gtk.Assets
    MediaCopy.Gtk.Environment
    MediaCopy.Gtk.Interpret
    MediaCopy.Gtk.Reload
    MediaCopy.Gtk.Resources.Splice
    MediaCopy.Gtk.Runtime
    MediaCopy.Gtk.Screenshot
    MediaCopy.Gtk.Theme
    MediaCopy.Gtk.View
    MediaCopy.Gtk.Widgets.Bind
    MediaCopy.Gtk.Widgets.CommandPalette
    MediaCopy.Gtk.Widgets.Common
    MediaCopy.Gtk.Widgets.FieldRows
    MediaCopy.Gtk.Widgets.FileRow
    MediaCopy.Gtk.Widgets.History
    MediaCopy.Gtk.Widgets.JobDetail
    MediaCopy.Gtk.Widgets.JobRow
    MediaCopy.Gtk.Widgets.OffloadDialog
    MediaCopy.Gtk.Widgets.PlanSheet
    MediaCopy.Gtk.Widgets.PluginsPage
    MediaCopy.Gtk.Widgets.Preferences

  other-modules: Paths_mediacopy3000
  autogen-modules: Paths_mediacopy3000
  build-depends:
    aeson,
    ascmhl,
    async,
    base,
    bytestring,
    containers,
    directory,
    effectful-core,
    extra,
    file-io,
    filepath,
    gi-adwaita ^>=1.0,
    gi-gdk4,
    gi-gio ^>=2.0,
    gi-glib ^>=2.0,
    gi-gobject ^>=2.0,
    gi-gsk,
    gi-gtk ^>=4.0,
    gi-pango ^>=1.0,
    haskell-gi-base,
    hostname,
    log-base ^>=0.12,
    log-effectful ^>=1.0,
    mediacopy3000:application,
    mediacopy3000:domain,
    mediacopy3000:interface,
    monad-time-effectful,
    plugin-protocol,
    process,
    template-haskell,
    text,
    text-display,
    time,
    vector,

  pkgconfig-depends:
    gtk4 >=4.14,
    libadwaita-1 >=1.5,

executable mediacopy3000
  import: options
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N2

  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    ascmhl,
    base,
    containers,
    effectful-core,
    filepath,
    mediacopy3000,
    mediacopy3000:application,
    mediacopy3000:demo,
    mediacopy3000:domain,
    mediacopy3000:interface,
    optparse-applicative,
    plugin-protocol,
    text,
    text-display,
    time,

executable render-bench
  import: options
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N2

  main-is: Main.hs
  hs-source-dirs: bench
  build-depends:
    ascmhl,
    base,
    directory,
    extra,
    gi-adwaita ^>=1.0,
    gi-gdk4,
    gi-gio ^>=2.0,
    gi-glib ^>=2.0,
    gi-gtk ^>=4.0,
    haskell-gi-base,
    mediacopy3000,
    mediacopy3000:demo,
    mediacopy3000:domain,
    mediacopy3000:interface,
    text,
    time,
    vector,

test-suite core-test
  import: options
  type: exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is: Main.hs
  -- cabal-gild: discover tests/ --exclude tests/Main.hs
  other-modules:
    MediaCopy.Domain.DirectoryHashTest
    MediaCopy.Domain.JobFormatTest
    MediaCopy.Domain.JobTest
    MediaCopy.Domain.PlanTest
    MediaCopy.Effects.FileSystemTest
    MediaCopy.EngineTest
    MediaCopy.Interface.ThemeTest
    MediaCopy.Interface.WordingTest
    MediaCopy.ModelTest
    MediaCopy.Test.InMemoryFS

  build-depends:
    ascmhl,
    base,
    bytestring,
    containers,
    directory,
    effectful-core,
    file-io,
    filepath,
    hedgehog,
    mediacopy3000:application,
    mediacopy3000:demo,
    mediacopy3000:domain,
    mediacopy3000:interface,
    monad-time-effectful,
    os-string,
    tasty,
    tasty-hedgehog,
    tasty-hunit,
    text,
    text-display,
    time,
    vector,

test-suite conformance-test
  import: options
  type: exitcode-stdio-1.0
  hs-source-dirs: tests-conformance
  main-is: Main.hs
  other-modules:
    MediaCopy.Conformance.Ascmhl
    MediaCopy.Conformance.Harness
    MediaCopy.Conformance.InteropTest
    MediaCopy.Conformance.OursToReferenceTest
    MediaCopy.Conformance.ReferenceToOursTest

  build-depends:
    ascmhl,
    base,
    bytestring,
    containers,
    directory,
    effectful-core,
    filepath,
    mediacopy3000:application,
    mediacopy3000:domain,
    monad-time-effectful,
    process,
    tasty,
    tasty-hunit,
    temporary,
    text,
    text-display,
    time,
    vector,
