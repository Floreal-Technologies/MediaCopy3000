<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSI. scripts/package.ps1 stages the files and generates staged-files.wxs,
  which defines the ComponentGroup this file references.

  The install is per-user, so no step asks for elevation. A videographer on a
  locked-down edit-bay machine can install it without an administrator.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- The upgrade code identifies the product across every version. It must never change. -->
  <Package
      Name="MediaCopy 3000"
      Manufacturer="Feriel Choutri de Tarlé"
      Version="$(var.Version)"
      UpgradeCode="6f3a1d24-7c58-4f0b-9a2e-1b8d5c4e7a90"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of MediaCopy 3000 is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="packaging/windows/mediacopy3000.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Floreal-Technologies/MediaCopy3000" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="MediaCopy 3000" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="MediaCopy 3000" />
    </StandardDirectory>

    <Feature Id="Main" Title="MediaCopy 3000" Level="1">
      <ComponentGroupRef Id="StagedFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!--
      A per-user component cannot use a file as its key path, so the shortcut's
      key path is a registry value under HKCU.
    -->
    <Component Id="StartMenuShortcut" Directory="ShortcutFolder" Guid="*">
      <Shortcut Id="AppShortcut"
                Name="MediaCopy 3000"
                Description="Verified media offload and ASC MHL verification"
                Target="[INSTALLFOLDER]mediacopy3000.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\MediaCopy3000"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Package>
</Wix>
