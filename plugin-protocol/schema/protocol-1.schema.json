{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floreal.tech/schemas/mediacopy3000/plugin-protocol-1.schema.json",
  "title": "MediaCopy 3000 plug-in protocol, API 1.0",
  "description": "JSON-RPC 2.0 protocol for MC3K and plugins",
  "$ref": "#/$defs/manifest",
  "x-methods": {
    "contribute": {
      "params": {
        "$ref": "#/$defs/contributeParams"
      },
      "result": {
        "$ref": "#/$defs/contributeResult"
      }
    },
    "initialise": {
      "params": {
        "$ref": "#/$defs/initialiseParams"
      },
      "result": {
        "$ref": "#/$defs/initialiseResult"
      }
    },
    "inspect/file": {
      "params": {
        "$ref": "#/$defs/inspectFileParams"
      },
      "result": {
        "$ref": "#/$defs/inspectFileResult"
      }
    },
    "inspect/plan": {
      "params": {
        "$ref": "#/$defs/inspectPlanParams"
      },
      "result": {
        "$ref": "#/$defs/inspectPlanResult"
      }
    },
    "job/finished": {
      "params": {
        "$ref": "#/$defs/jobFinishedParams"
      },
      "result": {
        "$ref": "#/$defs/jobFinishedResult"
      }
    },
    "shutdown": {
      "params": {
        "type": "object"
      },
      "result": {}
    }
  },
  "x-notifications": {
    "$/log": {
      "$ref": "#/$defs/logLine"
    },
    "$/progress": {
      "$ref": "#/$defs/progress"
    }
  },
  "$defs": {
    "annotation": {
      "type": "object",
      "required": [
        "value",
        "label",
        "key"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "author": {
      "description": "Each text holds only characters that XML 1.0 allows.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "role": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "authorSlot": {
      "description": "One author slot of a setting of kind authors. In plugins.json, name, email and phone are the defaults. In initialise.settings, they are the merged values for the job, and slots with no name are removed.",
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "phone": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capability": {
      "oneOf": [
        {
          "const": "files.read"
        },
        {
          "const": "plan.inspect"
        },
        {
          "const": "files.inspect"
        },
        {
          "const": "block"
        },
        {
          "const": "manifest.write"
        },
        {
          "const": "job.finished"
        }
      ]
    },
    "contributeParams": {
      "type": "object",
      "required": [
        "files",
        "job"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileInfo"
          }
        },
        "job": {
          "$ref": "#/$defs/jobInfo"
        }
      }
    },
    "contributeResult": {
      "type": "object",
      "required": [
        "fileMetadata",
        "authors"
      ],
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/author"
          }
        },
        "fileMetadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileMetadata"
          }
        },
        "manifestMetadata": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "field": {
      "description": "A setting or a job field. The kind authors is allowed only in settings, only once, only with manifest.write, and without default. Its stored value and its value in initialise are arrays of authorSlot.",
      "type": "object",
      "required": [
        "kind",
        "label",
        "key"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "default": false
        },
        "default": {
          "anyOf": [
            {
              "type": "null"
            },
            {}
          ]
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "secret",
            "email",
            "bool",
            "choice",
            "path",
            "authors"
          ]
        },
        "label": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "authors"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "default"
              ]
            }
          }
        }
      ]
    },
    "fileInfo": {
      "type": "object",
      "required": [
        "size",
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      }
    },
    "fileMetadata": {
      "type": "object",
      "required": [
        "xml",
        "path"
      ],
      "properties": {
        "path": {
          "description": "The path of one of the files of the request.",
          "type": "string"
        },
        "xml": {
          "description": "XML elements in the namespace of the plug-in, at most 32 levels deep, with only characters that XML 1.0 allows. Comments and processing instructions are removed.",
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "detail",
        "title",
        "severity",
        "key"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        }
      }
    },
    "hashAlgo": {
      "description": "The name of a hash format, as the element name in an ASC MHL manifest.",
      "enum": [
        "xxh64",
        "md5",
        "sha1",
        "c4"
      ]
    },
    "hashValue": {
      "type": "object",
      "required": [
        "value",
        "algo"
      ],
      "properties": {
        "algo": {
          "$ref": "#/$defs/hashAlgo"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "initialiseParams": {
      "type": "object",
      "required": [
        "entitlement",
        "grants",
        "jobFields",
        "settings",
        "job",
        "locale",
        "app",
        "minor",
        "api"
      ],
      "properties": {
        "api": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "app": {
          "type": "string"
        },
        "entitlement": {
          "description": "Always null in API 1.0.",
          "type": "null"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "job": {
          "$ref": "#/$defs/jobKind"
        },
        "jobFields": {
          "type": "object",
          "additionalProperties": {}
        },
        "locale": {
          "type": "string"
        },
        "minor": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "settings": {
          "description": "One value per setting, by key. A setting of kind authors holds an array of authorSlot.",
          "type": "object",
          "additionalProperties": {}
        }
      }
    },
    "initialiseResult": {
      "type": "object",
      "required": [
        "api"
      ],
      "properties": {
        "api": {
          "type": "integer",
          "const": 1,
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      }
    },
    "inspectFileParams": {
      "type": "object",
      "required": [
        "size",
        "hashes",
        "location",
        "path"
      ],
      "properties": {
        "hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hashValue"
          }
        },
        "location": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      }
    },
    "inspectFileResult": {
      "type": "object",
      "required": [
        "warnings",
        "annotations"
      ],
      "properties": {
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "inspectPlanParams": {
      "type": "object",
      "required": [
        "readBudgetBytes",
        "files",
        "job"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileInfo"
          }
        },
        "job": {
          "$ref": "#/$defs/jobInfo"
        },
        "readBudgetBytes": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      }
    },
    "inspectPlanResult": {
      "type": "object",
      "required": [
        "findings"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "jobFinishedOutcome": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "allOk"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "message"
          ],
          "properties": {
            "message": {
              "type": "string"
            },
            "status": {
              "const": "failed"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "count"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            "status": {
              "const": "withFailures"
            }
          }
        }
      ]
    },
    "jobFinishedParams": {
      "type": "object",
      "required": [
        "manifests",
        "outcome",
        "job"
      ],
      "properties": {
        "job": {
          "$ref": "#/$defs/jobInfo"
        },
        "manifests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manifestInfo"
          }
        },
        "outcome": {
          "$ref": "#/$defs/jobFinishedOutcome"
        }
      }
    },
    "jobFinishedResult": {
      "type": "object",
      "required": [
        "warnings"
      ],
      "properties": {
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "jobInfo": {
      "type": "object",
      "required": [
        "destinations",
        "source",
        "kind"
      ],
      "properties": {
        "destinations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hashFormat": {
          "$ref": "#/$defs/hashAlgo"
        },
        "kind": {
          "$ref": "#/$defs/jobKind"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "jobKind": {
      "enum": [
        "offload",
        "verify",
        "seal"
      ]
    },
    "logLine": {
      "type": "object",
      "required": [
        "message",
        "level"
      ],
      "properties": {
        "level": {
          "description": "For example debug, info, warning or error. The event log shows the level before the message.",
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "executable",
        "api",
        "version",
        "description",
        "name",
        "id",
        "capabilities"
      ],
      "properties": {
        "description": {
          "description": "One or two short sentences that tell what the plug-in does. The preferences page shows it under the name.",
          "type": "string",
          "pattern": "\\S"
        },
        "api": {
          "type": "integer",
          "const": 1,
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "capabilities": {
          "description": "At least one of plan.inspect, files.inspect, manifest.write and job.finished.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          },
          "contains": {
            "enum": [
              "plan.inspect",
              "files.inspect",
              "manifest.write",
              "job.finished"
            ]
          }
        },
        "executable": {
          "description": "Keys: linux-x86_64, linux-aarch64, macos-aarch64, macos-x86_64, windows-x86_64. Values: paths relative to the plug-in folder. A path does not start with '/' or '\\', holds no ':', and has no '..' part. One bad path, for any platform, rejects the plug-in on every platform.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?![/\\\\])(?!.*:)(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$)).+$"
          }
        },
        "id": {
          "$ref": "#/$defs/pluginId"
        },
        "jobFields": {
          "description": "Keys are unique. No job field has the kind authors.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/field",
            "properties": {
              "kind": {
                "not": {
                  "const": "authors"
                }
              }
            }
          }
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "description": "The only XML namespace that a plug-in with manifest.write can write. It cannot be empty, a namespace of ASC MHL, or a namespace that XML reserves.",
          "type": "string",
          "not": {
            "enum": [
              "",
              "urn:ASC:MHL:v2.0",
              "urn:ASC:MHL:DIRECTORY:v2.0",
              "http://www.w3.org/XML/1998/namespace",
              "http://www.w3.org/2000/xmlns/"
            ]
          }
        },
        "settings": {
          "description": "Keys are unique. At most one setting has the kind authors.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "contains": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "authors"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        "version": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "block"
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "plan.inspect"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "manifest.write"
                }
              }
            }
          },
          "then": {
            "required": [
              "namespace"
            ]
          }
        },
        {
          "if": {
            "required": [
              "settings"
            ],
            "properties": {
              "settings": {
                "contains": {
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "authors"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "manifest.write"
                }
              }
            }
          }
        }
      ]
    },
    "manifestInfo": {
      "type": "object",
      "required": [
        "path",
        "destination"
      ],
      "properties": {
        "destination": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "pluginId": {
      "description": "A reverse domain name in lowercase, for example tech.floreal.c2pa-reader. It holds at least one '.', it does not start or end with '.', and it has no '..'. It is also the name of the folder of the plug-in.",
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[a-z0-9_-][a-z0-9._-]*\\.[a-z0-9._-]*[a-z0-9_-]$"
    },
    "progress": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "fraction": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "severity": {
      "oneOf": [
        {
          "const": "blocker"
        },
        {
          "const": "warning"
        }
      ]
    }
  }
}
