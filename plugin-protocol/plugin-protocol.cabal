cabal-version: 3.4
name: plugin-protocol
version: 0.1.0.0
synopsis: Plugin format between MC3K and plugins
description:
license: BSD-3-Clause
license-file: LICENSE
author: Feriel Choutri de Tarlé
maintainer: feriel@choutri.eu
category: Network
build-type: Simple
extra-source-files: schema/protocol-1.schema.json
tested-with: ghc ==9.14.1

common options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -fhide-source-paths
    -Wno-unused-do-bind
    -fshow-hole-constraints
    -Wno-unticked-promoted-constructors
    -fwrite-ide-info

  default-extensions:
    DerivingVia
    DuplicateRecordFields
    NoFieldSelectors
    NoStarIsType
    OrPatterns
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    StrictData
    TypeFamilies
    ViewPatterns

  default-language: GHC2024

library
  import: options
  hs-source-dirs: src
  -- cabal-gild: discover src
  exposed-modules:
    MediaCopy.Plugin.Api
    MediaCopy.Plugin.AuthorSlot
    MediaCopy.Plugin.Capability
    MediaCopy.Plugin.Field
    MediaCopy.Plugin.Id
    MediaCopy.Plugin.JsonRpc
    MediaCopy.Plugin.JsonRpc.Error
    MediaCopy.Plugin.JsonRpc.Incoming
    MediaCopy.Plugin.JsonRpc.Request
    MediaCopy.Plugin.JsonSchema
    MediaCopy.Plugin.Manifest
    MediaCopy.Plugin.Protocol.Contribute
    MediaCopy.Plugin.Protocol.FileInfo
    MediaCopy.Plugin.Protocol.Finding
    MediaCopy.Plugin.Protocol.HashValue
    MediaCopy.Plugin.Protocol.Initialise
    MediaCopy.Plugin.Protocol.InspectFile
    MediaCopy.Plugin.Protocol.InspectPlan
    MediaCopy.Plugin.Protocol.JobFinished
    MediaCopy.Plugin.Protocol.JobInfo
    MediaCopy.Plugin.Protocol.LogLine
    MediaCopy.Plugin.Protocol.Method
    MediaCopy.Plugin.Protocol.Progress
    MediaCopy.Plugin.Schema
    MediaCopy.Plugin.Schema.Patch

  build-depends:
    aeson,
    aeson-pretty,
    autodocodec,
    autodocodec-schema,
    base,
    bytestring,
    containers,
    scientific,
    text,
    text-display ^>=1.0.0.0,
    unordered-containers,
    vector,

test-suite plugin-protocol-test
  import: options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    MediaCopy.Plugin.Generators
    MediaCopy.Plugin.JsonRpcTest
    MediaCopy.Plugin.ManifestTest
    MediaCopy.Plugin.ProtocolTest
    MediaCopy.Plugin.SchemaTest

  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    hedgehog,
    plugin-protocol,
    tasty,
    tasty-hedgehog,
    tasty-hunit,
    text,
    vector,
